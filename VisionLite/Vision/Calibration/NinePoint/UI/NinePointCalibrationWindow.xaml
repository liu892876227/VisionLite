<Window x:Class="VisionLite.Vision.Calibration.NinePoint.UI.NinePointCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:halcon="clr-namespace:HalconDotNet;assembly=halcondotnet"
        Title="九点标定" Height="800" Width="1200" 
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        
        <Style x:Key="PointButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <DataTemplate x:Key="CalibrationListTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" Width="150" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CalibrationTime, StringFormat=yyyy-MM-dd HH:mm}" 
                          Width="120" VerticalAlignment="Center" Margin="5,0"/>
                <TextBlock Text="{Binding Quality}" Width="60" VerticalAlignment="Center"/>
                <Ellipse Width="12" Height="12" Margin="5,0" Fill="Green"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 工具栏 -->
        <ToolBar Grid.Row="0" ToolBarTray.IsLocked="True">
            <Button Name="btnNewCalibration" Content="新建标定" Style="{StaticResource ButtonStyle}" 
                    Click="BtnNewCalibration_Click"/>
            <Button Name="btnLoadCalibration" Content="加载标定" Style="{StaticResource ButtonStyle}"
                    Click="BtnLoadCalibration_Click"/>
            <Button Name="btnSaveCalibration" Content="保存标定" Style="{StaticResource ButtonStyle}"
                    Click="BtnSaveCalibration_Click"/>
            <Separator/>
            <Button Name="btnImportCalibration" Content="导入" Style="{StaticResource ButtonStyle}"
                    Click="BtnImportCalibration_Click"/>
            <Button Name="btnExportCalibration" Content="导出" Style="{StaticResource ButtonStyle}"
                    Click="BtnExportCalibration_Click"/>
            <Separator/>
            <Button Name="btnLoadImage" Content="加载图像" Style="{StaticResource ButtonStyle}"
                    Click="BtnLoadImage_Click"/>
            <Separator/>
            <Button Name="btnStartCalibration" Content="开始标定" Style="{StaticResource ButtonStyle}"
                    Click="BtnStartCalibration_Click"/>
            <Button Name="btnApplyCalibration" Content="应用标定" Style="{StaticResource ButtonStyle}"
                    Click="BtnApplyCalibration_Click"/>
            <Button Name="btnResetCalibration" Content="重置" Style="{StaticResource ButtonStyle}"
                    Click="BtnResetCalibration_Click"/>
        </ToolBar>
        
        <!-- 主要内容区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- 左侧面板 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- 标定配置管理 -->
                <GroupBox Grid.Row="0" Header="标定配置" Style="{StaticResource GroupBoxStyle}">
                    <StackPanel>
                        <ComboBox Name="cmbCalibrations" Height="25" Margin="0,0,0,5"
                                 SelectionChanged="CmbCalibrations_SelectionChanged"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Name="btnDeleteCalibration" Content="删除" Width="60" Height="25" Margin="2"
                                   Click="BtnDeleteCalibration_Click"/>
                            <Button Name="btnDuplicateCalibration" Content="复制" Width="60" Height="25" Margin="2"
                                   Click="BtnDuplicateCalibration_Click"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                
                <!-- 标定点设置 -->
                <GroupBox Grid.Row="1" Header="标定点设置" Style="{StaticResource GroupBoxStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 标定参数 -->
                            <Expander Header="标定参数" IsExpanded="True" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Label Grid.Row="0" Grid.Column="0" Content="标定名称:"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Name="txtCalibrationName" 
                                            Text="{Binding CalibrationName, UpdateSourceTrigger=PropertyChanged}"/>
                                    
                                    <Label Grid.Row="1" Grid.Column="0" Content="变换类型:"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="仿射变换" 
                                              VerticalAlignment="Center" Margin="5,0"/>
                                    
                                    <Label Grid.Row="2" Grid.Column="0" Content="物理单位:"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" Name="cmbPhysicalUnit"/>
                                    
                                    <Label Grid.Row="3" Grid.Column="0" Content="误差阈值:"/>
                                    <xctk:DoubleUpDown Grid.Row="3" Grid.Column="1" Name="nudErrorThreshold"
                                                      Value="{Binding ErrorThreshold}" Minimum="0.01" Maximum="10"
                                                      Increment="0.1" FormatString="F2"/>
                                </Grid>
                            </Expander>
                            
                            <!-- 九个标定点 -->
                            <Expander Header="标定点" IsExpanded="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Button Grid.Row="0" Grid.Column="0" Name="btnPoint1" Content="点1" 
                                           Style="{StaticResource PointButtonStyle}" Click="BtnPoint_Click" Tag="1"/>
                                    <Button Grid.Row="0" Grid.Column="1" Name="btnPoint2" Content="点2"
                                           Style="{StaticResource PointButtonStyle}" Click="BtnPoint_Click" Tag="2"/>
                                    <Button Grid.Row="0" Grid.Column="2" Name="btnPoint3" Content="点3"
                                           Style="{StaticResource PointButtonStyle}" Click="BtnPoint_Click" Tag="3"/>
                                    
                                    <Button Grid.Row="1" Grid.Column="0" Name="btnPoint4" Content="点4"
                                           Style="{StaticResource PointButtonStyle}" Click="BtnPoint_Click" Tag="4"/>
                                    <Button Grid.Row="1" Grid.Column="1" Name="btnPoint5" Content="点5"
                                           Style="{StaticResource PointButtonStyle}" Click="BtnPoint_Click" Tag="5"/>
                                    <Button Grid.Row="1" Grid.Column="2" Name="btnPoint6" Content="点6"
                                           Style="{StaticResource PointButtonStyle}" Click="BtnPoint_Click" Tag="6"/>
                                    
                                    <Button Grid.Row="2" Grid.Column="0" Name="btnPoint7" Content="点7"
                                           Style="{StaticResource PointButtonStyle}" Click="BtnPoint_Click" Tag="7"/>
                                    <Button Grid.Row="2" Grid.Column="1" Name="btnPoint8" Content="点8"
                                           Style="{StaticResource PointButtonStyle}" Click="BtnPoint_Click" Tag="8"/>
                                    <Button Grid.Row="2" Grid.Column="2" Name="btnPoint9" Content="点9"
                                           Style="{StaticResource PointButtonStyle}" Click="BtnPoint_Click" Tag="9"/>
                                </Grid>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>
                
                <!-- 标定结果 -->
                <GroupBox Grid.Row="2" Header="标定结果" Style="{StaticResource GroupBoxStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Label Grid.Row="0" Grid.Column="0" Content="状态:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Name="txtCalibrationStatus" 
                                  Style="{StaticResource StatusTextStyle}"/>
                        
                        <Label Grid.Row="1" Grid.Column="0" Content="点数:"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Name="txtValidPointCount"
                                  Style="{StaticResource StatusTextStyle}"/>
                        
                        <Label Grid.Row="2" Grid.Column="0" Content="误差:"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Name="txtCalibrationError"
                                  Style="{StaticResource StatusTextStyle}"/>
                        
                        <Label Grid.Row="3" Grid.Column="0" Content="质量:"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Name="txtCalibrationQuality"
                                  Style="{StaticResource StatusTextStyle}"/>
                        
                        <Label Grid.Row="4" Grid.Column="0" Content="比例:"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Name="txtPixelScale"
                                  Style="{StaticResource StatusTextStyle}"/>
                        
                        <!-- 分隔线 -->
                        <Separator Grid.Row="5" Grid.ColumnSpan="2" Margin="0,10"/>
                        
                        <!-- 全局标定状态 -->
                        <Label Grid.Row="6" Grid.Column="0" Content="全局状态:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Name="txtGlobalCalibrationStatus" 
                                  Style="{StaticResource StatusTextStyle}" Foreground="DarkBlue"/>
                    </Grid>
                </GroupBox>
            </Grid>
            
            <!-- 分隔线 -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#EEEEEE"/>
            
            <!-- 右侧图像显示和点设置 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="250" MinHeight="200"/>
                </Grid.RowDefinitions>
                
                <!-- 图像显示区域 -->
                <GroupBox Grid.Row="0" Header="图像显示" Style="{StaticResource GroupBoxStyle}">
                    <Border BorderBrush="#CCCCCC" BorderThickness="1">
                        <Grid Name="imageDisplayContainer" Background="Black">
                            <halcon:HSmartWindowControlWPF Name="halconWindow" 
                                                          HorizontalAlignment="Stretch" 
                                                          VerticalAlignment="Stretch"/>
                            <TextBlock Name="txtImagePlaceholder" Text="点击'加载图像'选择标定图像" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center" 
                                      Foreground="White" FontSize="16"/>
                        </Grid>
                    </Border>
                </GroupBox>
                
                <!-- 点坐标设置 -->
                <GroupBox Grid.Row="1" Header="点坐标设置" Style="{StaticResource GroupBoxStyle}">
                    <TabControl Name="pointDetailsTabControl">
                        <TabItem Header="当前点">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- 列 0: "图像/世界坐标:" 标签 -->
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- 列 1: "X:" 标签 -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- 列 2: X坐标输入框 -->
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- 列 3: "Y:" 标签 -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- 列 4: Y坐标输入框 -->
                                </Grid.ColumnDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Content="当前点:" FontWeight="Bold"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Name="txtCurrentPointName" 
                                          VerticalAlignment="Center" FontWeight="Bold"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="图像坐标:" VerticalAlignment="Center"/>
                                <Label Grid.Row="1" Grid.Column="1" Content="X:" VerticalAlignment="Center" Margin="5,0"/>
                                <xctk:DoubleUpDown Grid.Row="1" Grid.Column="2" Name="nudImageX"
                                                  FormatString="F3" Increment="0.1"/>
                                <Label Grid.Row="1" Grid.Column="3" Content="Y:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <xctk:DoubleUpDown Grid.Row="1" Grid.Column="4" Name="nudImageY"
                                                  FormatString="F3" Increment="0.1"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="世界坐标:" VerticalAlignment="Center"/>
                                <Label Grid.Row="2" Grid.Column="1" Content="X:" VerticalAlignment="Center" Margin="5,0"/>
                                <xctk:DoubleUpDown Grid.Row="2" Grid.Column="2" Name="nudWorldX"
                                                  FormatString="F3" Increment="0.1"/>
                                <Label Grid.Row="2" Grid.Column="3" Content="Y:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <xctk:DoubleUpDown Grid.Row="2" Grid.Column="4" Name="nudWorldY"
                                                  FormatString="F3" Increment="0.1"/>

                                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" 
                                           Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                                    <Button Name="btnSetCurrentPoint" Content="设置当前点" 
                                           Style="{StaticResource ButtonStyle}" Click="BtnSetCurrentPoint_Click"/>
                                    <Button Name="btnClearCurrentPoint" Content="清除当前点"
                                           Style="{StaticResource ButtonStyle}" Click="BtnClearCurrentPoint_Click"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                        
                        <TabItem Header="所有点">
                            <DataGrid Name="dgPointDetails" AutoGenerateColumns="False" 
                                     CanUserAddRows="False" CanUserDeleteRows="False"
                                     SelectionChanged="DgPointDetails_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="点名" Binding="{Binding PointName}" Width="60" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="图像X" Binding="{Binding ImagePoint.X, StringFormat=F3}" Width="80"/>
                                    <DataGridTextColumn Header="图像Y" Binding="{Binding ImagePoint.Y, StringFormat=F3}" Width="80"/>
                                    <DataGridTextColumn Header="世界X" Binding="{Binding WorldPoint.X, StringFormat=F3}" Width="80"/>
                                    <DataGridTextColumn Header="世界Y" Binding="{Binding WorldPoint.Y, StringFormat=F3}" Width="80"/>
                                    <DataGridCheckBoxColumn Header="已设置" Binding="{Binding IsSet}" Width="60" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="拟合误差" Binding="{Binding FitError, StringFormat=F3}" Width="80" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </GroupBox>
            </Grid>
        </Grid>
        
        <!-- 状态栏 -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Name="txtStatusBar" Text="就绪"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="当前标定: "/>
                    <TextBlock Name="txtCurrentCalibrationName" FontWeight="Bold"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Name="txtCoordinateDisplay" Text="鼠标坐标: (0, 0)"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>